generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  members     User[]

  @@index([name])
}

model WorkspaceRole {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  password              String
  name                  String
  avatarUrl             String?
  dailySheetUrl         String?
  starRating            Int                   @default(1)
  employmentType        EmploymentType        @default(FULL_TIME)
  isActive              Boolean               @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  systemRole            SystemRole            @default(MEMBER)
  primaryRole           String?
  secondaryRole         String?
  tertiaryRole          String?
  minorRole             String?
  teamId                String?
  googleId              String?               @unique
  imageUrl              String?
  uploadedAttachments   Attachment[]
  auditLogs             AuditLog[]
  createdChannels       Channel[]             @relation("ChannelCreatedBy")
  channelMemberships    ChannelMember[]
  checkedItems          ChecklistItem[]       @relation("ItemChecker")
  favorites             Favorite[]
  sentInvitations       Invitation[]          @relation("UserInvitations")
  pinnedMessages        Message[]             @relation("MessagePinnedBy")
  messagesSent          Message[]
  messageMentions       MessageMention[]      @relation("UserMentions")
  notifications         MessageNotification[]
  messageReactions      MessageReaction[]
  readReceipts          MessageReadReceipt[]
  savedMessages         SavedMessage[]
  ownedSpaces           Space[]               @relation("SpaceOwner")
  Subtask               Subtask[]
  assignedTasks         Task[]                @relation("TaskAssignee")
  createdTasks          Task[]                @relation("TaskCreator")
  taskCommentReactions  TaskCommentReaction[]
  taskNotificationsSent TaskNotification[]    @relation("ActorNotification")
  taskNotifications     TaskNotification[]    @relation("UserNotification")
  team                  Team?                 @relation(fields: [teamId], references: [id])
  assignedTasksMulti    Task[]                @relation("TaskMultiAssignees")
  taskComments          TaskComment[]

  @@index([email])
  @@index([systemRole])
  @@index([teamId])
  @@index([primaryRole])
}

model Space {
  id        String    @id @default(uuid())
  name      String
  icon      String?
  color     String?
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  order     Int       @default(0)
  channels  Channel[]
  docs      Doc[]
  folders   Folder[]
  lists     List[]
  owner     User      @relation("SpaceOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([name])
}

model Folder {
  id             String   @id @default(uuid())
  name           String
  spaceId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  parentFolderId String?
  order          Int      @default(0)
  docs           Doc[]
  parentFolder   Folder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  subfolders     Folder[] @relation("FolderHierarchy")
  space          Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  lists          List[]

  @@index([spaceId])
  @@index([parentFolderId])
}

model List {
  id           String       @id @default(uuid())
  name         String
  spaceId      String?
  folderId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  customGroups String[]     @default([])
  order        Int          @default(0)
  folder       Folder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  space        Space?       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  statuses     ListStatus[]
  tasks        Task[]

  @@index([spaceId])
  @@index([folderId])
}

model ListStatus {
  id           String   @id @default(uuid())
  name         String
  color        String   @default("zinc")
  allowedRoles String[] @default([])
  listId       String
  createdAt    DateTime @default(now())
  groupName    String?
  list         List     @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

model Doc {
  id               String   @id @default(uuid())
  title            String
  docDate          DateTime @default(now())
  spaceId          String?
  folderId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isDailyRollover  Boolean  @default(false)
  rolloverTimezone String   @default("Asia/Singapore")
  order            Int      @default(0)
  folder           Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  space            Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  pages            Page[]

  @@index([spaceId])
  @@index([folderId])
}

model Page {
  id           String    @id @default(uuid())
  title        String
  content      String    @default("")
  docId        String
  parentPageId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isClosed     Boolean   @default(false)
  reportDate   DateTime?
  doc          Doc       @relation(fields: [docId], references: [id], onDelete: Cascade)
  parentPage   Page?     @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: Cascade)
  subpages     Page[]    @relation("PageHierarchy")

  @@index([docId])
  @@index([parentPageId])
  @@index([reportDate])
}

model Favorite {
  id         String     @id @default(uuid())
  userId     String
  entityType EntityType
  entityId   String
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType, entityId])
}

model Task {
  id            String             @id @default(uuid())
  title         String
  description   String?
  priority      Priority           @default(MEDIUM)
  listId        String
  creatorId     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  assigneeId    String?
  dueDate       DateTime?
  startDate     DateTime?
  status        String             @default("Pending")
  teamId        String?
  attachments   Attachment[]
  checklists    Checklist[]
  subtasks      Subtask[]
  assignee      User?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator       User               @relation("TaskCreator", fields: [creatorId], references: [id])
  list          List               @relation(fields: [listId], references: [id], onDelete: Cascade)
  team          Team?              @relation(fields: [teamId], references: [id])
  comments      TaskComment[]
  notifications TaskNotification[]
  assignees     User[]             @relation("TaskMultiAssignees")

  @@index([listId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([teamId])
  @@index([createdAt])
}

model Subtask {
  id          String        @id @default(uuid())
  title       String
  taskId      String
  createdAt   DateTime      @default(now())
  completed   Boolean       @default(false)
  assigneeId  String?
  dueDate     DateTime?
  priority    Priority      @default(MEDIUM)
  description String?
  checklists  Checklist[]
  User        User?         @relation(fields: [assigneeId], references: [id])
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comments    TaskComment[]

  @@index([taskId])
  @@index([assigneeId])
}

model Checklist {
  id        String          @id @default(uuid())
  taskId    String
  createdAt DateTime        @default(now())
  name      String
  subtaskId String?
  subtask   Subtask?        @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]

  @@index([taskId])
  @@index([subtaskId])
}

model ChecklistItem {
  id          String    @id @default(uuid())
  text        String
  checklistId String
  createdAt   DateTime  @default(now())
  checkedById String?
  completed   Boolean   @default(false)
  checkedBy   User?     @relation("ItemChecker", fields: [checkedById], references: [id])
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@index([checkedById])
}

model TaskComment {
  id              String                @id @default(uuid())
  content         String
  taskId          String
  userId          String
  createdAt       DateTime              @default(now())
  parentCommentId String?
  replyCount      Int                   @default(0)
  subtaskId       String?
  attachments     Attachment[]
  parentComment   TaskComment?          @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         TaskComment[]         @relation("CommentReplies")
  subtask         Subtask?              @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  task            Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reactions       TaskCommentReaction[]
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([subtaskId])
  @@index([userId])
  @@index([parentCommentId])
}

model TaskCommentReaction {
  id        String      @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@index([userId])
}

model Attachment {
  id            String       @id @default(uuid())
  fileName      String
  fileUrl       String
  fileKey       String
  fileSize      Int
  mimeType      String
  taskId        String?
  taskCommentId String?
  uploadedById  String
  createdAt     DateTime     @default(now())
  taskComment   TaskComment? @relation(fields: [taskCommentId], references: [id], onDelete: Cascade)
  task          Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([uploadedById])
}

model Channel {
  id          String          @id @default(uuid())
  name        String?
  description String?
  isPrivate   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  createdById String?
  isArchived  Boolean         @default(false)
  spaceId     String?
  topic       String?
  type        ChannelType     @default(PUBLIC)
  updatedAt   DateTime        @updatedAt
  createdBy   User?           @relation("ChannelCreatedBy", fields: [createdById], references: [id])
  space       Space?          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  members     ChannelMember[]
  messages    Message[]

  @@index([spaceId])
  @@index([createdById])
  @@index([type])
  @@index([isPrivate])
}

model ChannelMember {
  id                   String      @id @default(uuid())
  channelId            String
  userId               String
  role                 ChannelRole @default(MEMBER)
  notificationsEnabled Boolean     @default(true)
  lastReadAt           DateTime    @default(now())
  joinedAt             DateTime    @default(now())
  channel              Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model Message {
  id              String                @id @default(uuid())
  content         String
  senderId        String
  channelId       String
  isEdited        Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?
  editedAt        DateTime?
  isDeleted       Boolean               @default(false)
  isPinned        Boolean               @default(false)
  parentMessageId String?
  pinnedAt        DateTime?
  pinnedById      String?
  replyCount      Int                   @default(0)
  channel         Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parentMessage   Message?              @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         Message[]             @relation("MessageReplies")
  pinnedBy        User?                 @relation("MessagePinnedBy", fields: [pinnedById], references: [id])
  sender          User                  @relation(fields: [senderId], references: [id])
  attachments     MessageAttachment[]
  mentions        MessageMention[]
  notifications   MessageNotification[]
  reactions       MessageReaction[]
  readReceipts    MessageReadReceipt[]
  savedMessages   SavedMessage[]

  @@index([channelId, createdAt])
  @@index([senderId])
  @@index([parentMessageId])
  @@index([isPinned])
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  fileName  String
  fileUrl   String
  fileKey   String?
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model MessageMention {
  id              String   @id @default(uuid())
  messageId       String
  mentionedUserId String
  createdAt       DateTime @default(now())
  mentionedUser   User     @relation("UserMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([mentionedUserId])
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model SavedMessage {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  savedAt   DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MessageNotification {
  id        String           @id @default(uuid())
  userId    String
  messageId String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  message   Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([messageId])
}

model TaskNotification {
  id        String   @id @default(uuid())
  userId    String
  actorId   String?
  taskId    String?
  type      String
  title     String
  content   String?
  isRead    Boolean  @default(false)
  isCleared Boolean  @default(false)
  createdAt DateTime @default(now())
  actor     User?    @relation("ActorNotification", fields: [actorId], references: [id])
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation("UserNotification", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCleared])
  @@index([taskId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  userId    String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Invitation {
  id             String           @id @default(uuid())
  email          String
  role           SystemRole       @default(MEMBER)
  employmentType EmploymentType   @default(FULL_TIME)
  token          String           @unique @default(uuid())
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  invitedBy      User             @relation("UserInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
  @@index([invitedById])
}

enum SystemRole {
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  CONTRACTOR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EntityType {
  SPACE
  FOLDER
  LIST
  DOC
  PAGE
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DM
  GROUP_DM
}

enum ChannelRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum NotificationType {
  MENTION
  REPLY
  REACTION
  DIRECT_MESSAGE
  CHANNEL_MESSAGE
}
